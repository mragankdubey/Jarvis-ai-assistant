# J.A.R.V.I.S. Environment Configuration
# Copy this file to .env and fill in your API credentials.

# NewsAPI Configuration (https://newsapi.org/)
# Legacy lowercase "newsapi_key" is also supported for backward compatibility
NEWS_API_KEY=

# Groq Cloud API (https://console.groq.com/)
GROQ_API_KEY=

# Google Gemini API (https://aistudio.google.com/)
GEMINI_API_KEY=

# Assistant Personalization (Optional)
JARVIS_USER_NAME=Mragank
JARVIS_VOICE_RATE=180
JARVIS_VOICE_VOLUME=1.0
